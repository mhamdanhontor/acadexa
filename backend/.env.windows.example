# ==============================
# Acadexa backend — Windows local .env example
# Copy this file to backend/.env and adjust as needed.
# ==============================

APP_ENV=development
APP_NAME=Acadexa
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ENABLE_DOCS=true

# ------------------------------
# DATABASE
# Replace YOUR_PASSWORD with the password you set for the 'acadexa' role
# when running the setup SQL (see README-WINDOWS.md).
# ------------------------------
DATABASE_URL=postgresql+psycopg2://acadexa:YOUR_PASSWORD@localhost:5432/acadexa_db

# ------------------------------
# SECURITY / JWT — generate your own random value, do not reuse this one
# ------------------------------
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------
# CORS — the Vite dev server default port is 5173
# ------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------
# WHATSAPP PROVIDER — leave as 'fake' for local testing (no messages actually sent)
# ------------------------------
WHATSAPP_PROVIDER=fake
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------
# BACKUP — on Windows, PostgreSQL's bin directory must be on PATH, or set
# full paths here, e.g.:
#   PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
#   PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
# ------------------------------
BACKUP_DIR=./storage/backups
REPORTS_DIR=./storage/reports
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# ------------------------------
# NOTIFICATION WORKER
# ------------------------------
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
