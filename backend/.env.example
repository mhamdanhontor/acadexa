# ==============================
# APPLICATION
# ==============================
APP_ENV=development
APP_NAME=Acadexa
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ENABLE_DOCS=true

# ==============================
# DATABASE
# ==============================
DATABASE_URL=postgresql+psycopg2://acadexa:acadexa_dev_pass_2026@localhost:5432/acadexa_db

# ==============================
# SECURITY / JWT
# ==============================
SECRET_KEY=change-this-secret-key-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================
# WHATSAPP PROVIDER
# ==============================
WHATSAPP_PROVIDER=fake
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ==============================
# BACKUP
# ==============================
BACKUP_DIR=./storage/backups
REPORTS_DIR=./storage/reports
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=psql

# ==============================
# NOTIFICATION WORKER
# ==============================
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
